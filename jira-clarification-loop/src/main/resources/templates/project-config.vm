<html>
<head>
    <title>Demande infos sup - $projectName</title>
    <meta name="decorator" content="admin" />
    <meta name="projectKey" content="$projectKey" />
    <meta name="projectId" content="$projectId" />
    <meta name="admin.active.section" content="atl.jira.proj.config" />
    <meta name="admin.active.tab" content="clarification-project-config-link" />
</head>
<body>
    <div id="clr-config-panel" data-project-key="$projectKey">
        <h2>Demande d'informations supplémentaires</h2>
        <p class="clr-config-desc">Configurez la demande d'infos sup pour ce projet : activation, pause des SLA (Time to SLA), types de tickets concernés, états où la demande est possible et états où une demande en attente fige le ticket.</p>

        <div id="clr-config-loading" class="aui-message aui-message-info">
            <p>Chargement de la configuration...</p>
        </div>

        <div id="clr-config-error" class="aui-message aui-message-error" style="display:none;">
            <p id="clr-config-error-msg"></p>
        </div>

        <form id="clr-config-form" class="aui" style="display:none;">
            <!-- Activation & SLA -->
            <div class="clr-config-section">
                <div class="clr-config-section-header">
                    <h3>Activation et intégration SLA</h3>
                </div>
                <div class="clr-config-section-body">
                    <div class="clr-toggle-row">
                        <input type="checkbox" class="checkbox" id="clr-enabled" />
                        <div class="clr-toggle-text">
                            <label for="clr-enabled"><strong>Activer la demande d'infos sup sur ce projet</strong></label>
                            <div class="description">Si décoché, le panneau « Demande infos sup » n'apparaît plus sur les tickets de ce projet.</div>
                        </div>
                    </div>

                    <div class="clr-toggle-row clr-toggle-sla">
                        <input type="checkbox" class="checkbox" id="clr-pause-sla" />
                        <div class="clr-toggle-text">
                            <label for="clr-pause-sla"><strong>Synchroniser le champ SLA pour mettre en pause Time to SLA</strong></label>
                            <div class="description">
                                Met automatiquement le champ personnalisé <code id="clr-sla-field-name">Attente Infos Sup</code> à <code>Oui</code> lorsqu'une demande est en attente, puis à <code>Non</code> dès la réponse ou l'annulation.
                                <span id="clr-sla-field-info" class="clr-sla-badge"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Types de tickets -->
            <div class="clr-config-section">
                <div class="clr-config-section-header">
                    <div>
                        <h3>Types de tickets concernés</h3>
                        <span class="clr-section-sub">Sélectionnez les types de tickets sur lesquels le module est actif (tout cocher = tous les types).</span>
                    </div>
                    <span id="clr-it-counter" class="clr-counter-badge"></span>
                </div>
                <div class="clr-selector-toolbar">
                    <input type="text" id="clr-it-search" class="text clr-filter-input" placeholder="Filtrer les types de tickets..." autocomplete="off" />
                    <div class="clr-toolbar-actions">
                        <button type="button" class="aui-button aui-button-compact clr-select-all" data-target="clr-it-cb">Tout cocher</button>
                        <button type="button" class="aui-button aui-button-compact clr-select-none" data-target="clr-it-cb">Tout décocher</button>
                    </div>
                </div>
                <div id="clr-issue-types-list" class="clr-grid-box"></div>
            </div>

            <!-- États du ticket où l'on peut faire une demande d'infos sup -->
            <div class="clr-config-section">
                <div class="clr-config-section-header">
                    <div>
                        <h3>États du ticket autorisant la demande d'infos sup</h3>
                        <span class="clr-section-sub">Sélectionnez les états dans lesquels l'utilisateur peut demander des infos sup. Par défaut, tous les états finaux ne permettent pas de faire une demande.</span>
                    </div>
                    <span id="clr-req-st-counter" class="clr-counter-badge"></span>
                </div>
                <div class="clr-selector-toolbar">
                    <input type="text" id="clr-req-st-search" class="text clr-filter-input" placeholder="Rechercher un état..." autocomplete="off" />
                    <select id="clr-req-st-wf-filter" class="select clr-wf-select" style="display:none;">
                        <option value="">Tous les workflows</option>
                    </select>
                    <div class="clr-toolbar-actions">
                        <button type="button" id="clr-req-st-default" class="aui-button aui-button-compact" title="Autoriser tous les états sauf les états finaux">Hors états finaux (défaut)</button>
                        <button type="button" class="aui-button aui-button-compact clr-select-all" data-target="clr-req-st-cb">Tout autoriser</button>
                        <button type="button" class="aui-button aui-button-compact clr-select-none" data-target="clr-req-st-cb">Tout interdire</button>
                    </div>
                </div>
                <div id="clr-req-statuses-list" class="clr-grid-box clr-grid-box-statuses"></div>
            </div>

            <!-- États où une demande en attente fige le ticket (bloque les transitions) -->
            <div class="clr-config-section">
                <div class="clr-config-section-header">
                    <div>
                        <h3>États où une demande d'infos sup fige le ticket (bloque les transitions)</h3>
                        <span class="clr-section-sub">Sélectionnez les états dans lesquels une demande d'infos sup en attente fige l'état du ticket et verrouille ses transitions jusqu'à la réponse.</span>
                    </div>
                    <span id="clr-blk-st-counter" class="clr-counter-badge"></span>
                </div>
                <div class="clr-selector-toolbar">
                    <input type="text" id="clr-blk-st-search" class="text clr-filter-input" placeholder="Rechercher un état..." autocomplete="off" />
                    <select id="clr-blk-st-wf-filter" class="select clr-wf-select" style="display:none;">
                        <option value="">Tous les workflows</option>
                    </select>
                    <div class="clr-toolbar-actions">
                        <button type="button" class="aui-button aui-button-compact clr-select-all" data-target="clr-blk-st-cb">Tout figer</button>
                        <button type="button" class="aui-button aui-button-compact clr-select-none" data-target="clr-blk-st-cb">Tout débloquer</button>
                    </div>
                </div>
                <div id="clr-blk-statuses-list" class="clr-grid-box clr-grid-box-statuses"></div>
            </div>

            <div class="buttons-container clr-footer-bar">
                <div class="buttons">
                    <button type="submit" id="clr-save-btn" class="aui-button aui-button-primary">Enregistrer</button>
                    <span id="clr-save-status" class="clr-save-status"></span>
                </div>
            </div>
        </form>
    </div>

    <style>
        #clr-config-panel { max-width: 960px; padding-bottom: 32px; }
        #clr-config-panel .clr-config-desc { color: #5e6c84; margin-bottom: 20px; font-size: 14px; }
        #clr-config-panel .clr-config-section {
            background: #ffffff;
            border: 1px solid #dfe1e6;
            border-radius: 6px;
            margin-bottom: 20px;
            overflow: hidden;
        }
        #clr-config-panel .clr-config-section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 12px 16px;
            background: #f4f5f7;
            border-bottom: 1px solid #dfe1e6;
        }
        #clr-config-panel .clr-config-section-header h3 {
            margin: 0;
            font-size: 15px;
            font-weight: 600;
            color: #172b4d;
        }
        #clr-config-panel .clr-section-sub {
            display: block;
            font-size: 12px;
            color: #5e6c84;
            margin-top: 2px;
        }
        #clr-config-panel .clr-config-section-body {
            padding: 14px 16px;
        }
        #clr-config-panel .clr-toggle-row {
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }
        #clr-config-panel .clr-toggle-row input.checkbox {
            margin-top: 3px;
        }
        #clr-config-panel .clr-toggle-sla {
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid #ebecf0;
        }
        #clr-config-panel .clr-toggle-text label {
            color: #172b4d;
            cursor: pointer;
        }
        #clr-config-panel .clr-toggle-text .description {
            color: #5e6c84;
            font-size: 12px;
            margin-top: 3px;
        }
        #clr-config-panel .clr-toggle-text code {
            background: #ebecf0;
            color: #172b4d;
            padding: 1px 5px;
            border-radius: 3px;
            font-size: 12px;
        }
        #clr-config-panel .clr-sla-badge {
            display: inline-block;
            margin-left: 6px;
            color: #006644;
            background: #e3fcef;
            padding: 1px 6px;
            border-radius: 3px;
            font-size: 11px;
            font-weight: 600;
        }
        #clr-config-panel .clr-counter-badge {
            background: #dfe1e6;
            color: #253858;
            font-size: 12px;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 12px;
            white-space: nowrap;
        }
        #clr-config-panel .clr-selector-toolbar {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
            padding: 10px 16px;
            background: #fafbfc;
            border-bottom: 1px solid #ebecf0;
        }
        #clr-config-panel .clr-filter-input {
            flex: 1 1 200px;
            max-width: 280px !important;
            height: 30px;
            padding: 4px 10px;
            font-size: 13px;
            border: 1px solid #dfe1e6;
            border-radius: 3px;
        }
        #clr-config-panel .clr-wf-select {
            max-width: 220px !important;
            height: 30px;
            font-size: 13px;
            border: 1px solid #dfe1e6;
            border-radius: 3px;
            padding: 2px 8px;
        }
        #clr-config-panel .clr-toolbar-actions {
            margin-left: auto;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        #clr-config-panel .clr-grid-box {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 8px;
            padding: 12px 16px;
            max-height: 220px;
            overflow-y: auto;
            background: #ffffff;
        }
        #clr-config-panel .clr-grid-box-statuses {
            max-height: 280px;
        }
        #clr-config-panel .clr-check-card {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 10px;
            border: 1px solid #ebecf0;
            border-radius: 4px;
            background: #fafbfc;
            cursor: pointer;
            transition: background-color 0.1s ease, border-color 0.1s ease;
            margin: 0;
            min-width: 0;
        }
        #clr-config-panel .clr-check-card:hover {
            background: #f4f5f7;
            border-color: #c1c7d0;
        }
        #clr-config-panel .clr-check-card.clr-card-checked {
            background: #f4f5f7;
            border-color: #b3bac5;
        }
        #clr-config-panel .clr-check-card.clr-card-disallowed {
            background: #fff8f6;
            border-color: #ffbdad;
        }
        #clr-config-panel .clr-check-card input[type="checkbox"] {
            margin: 0;
            flex-shrink: 0;
        }
        #clr-config-panel .clr-card-title {
            flex: 1 1 auto;
            font-size: 13px;
            color: #172b4d;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        #clr-config-panel .clr-final-pill {
            flex-shrink: 0;
            font-size: 10px;
            font-weight: 600;
            color: #42526e;
            background: #dfe1e6;
            padding: 1px 5px;
            border-radius: 3px;
            white-space: nowrap;
        }
        #clr-config-panel .clr-wf-pill {
            flex-shrink: 0;
            font-size: 11px;
            color: #5e6c84;
            background: #ebecf0;
            padding: 1px 6px;
            border-radius: 3px;
            max-width: 75px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        #clr-config-panel .clr-state-pill {
            flex-shrink: 0;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            padding: 1px 6px;
            border-radius: 3px;
            white-space: nowrap;
        }
        #clr-config-panel .clr-pill-allowed {
            color: #006644;
            background: #e3fcef;
        }
        #clr-config-panel .clr-pill-disallowed {
            color: #bf2600;
            background: #ffebe6;
        }
        #clr-config-panel .clr-pill-frozen {
            color: #253858;
            background: #dfe1e6;
        }
        #clr-config-panel .clr-pill-unfrozen {
            color: #6b778c;
            background: #f4f5f7;
        }
        #clr-config-panel .clr-empty-msg {
            grid-column: 1 / -1;
            color: #6b778c;
            font-size: 13px;
            padding: 8px 0;
        }
        #clr-config-panel .clr-footer-bar {
            margin-top: 8px;
            padding: 0;
        }
        #clr-config-panel .clr-save-status {
            margin-left: 12px;
            font-weight: 600;
        }
    </style>

    <script type="text/javascript">
    (function () {
        function escapeHtml(s) {
            return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        function start() {
            var $ = AJS.$;
            var projectKey = $("#clr-config-panel").data("project-key");
            var restUrl = AJS.contextPath() + "/rest/clarification/1.0/issue/config/" + encodeURIComponent(projectKey);

            function updateCounter(cssClass, $counter, mode) {
                var $all = $("." + cssClass);
                var total = $all.length;
                var checked = $all.filter(":checked").length;
                if (total === 0) {
                    $counter.text("0 élément");
                    return;
                }
                if (mode === "allow-request") {
                    var forbidden = total - checked;
                    if (forbidden === 0) {
                        $counter.text("Tous autorisés (" + total + ")");
                    } else {
                        $counter.text(checked + " autorisé(s) · " + forbidden + " interdit(s)");
                    }
                } else if (mode === "freeze-status") {
                    var unfrozen = total - checked;
                    if (unfrozen === 0) {
                        $counter.text("Tous figés (" + total + ")");
                    } else {
                        $counter.text(checked + " figé(s) · " + unfrozen + " non figé(s)");
                    }
                } else {
                    if (checked === total) {
                        $counter.text("Tous sélectionnés (" + total + ")");
                    } else {
                        $counter.text(checked + " / " + total + " sélectionné(s)");
                    }
                }
            }

            function syncCardAppearance($cb, mode) {
                var $card = $cb.closest(".clr-check-card");
                var checked = $cb.prop("checked");
                var $pill = $card.find(".clr-state-pill");
                if (mode === "allow-request") {
                    $card.toggleClass("clr-card-checked", checked);
                    $card.toggleClass("clr-card-disallowed", !checked);
                    if ($pill.length) {
                        $pill
                            .removeClass("clr-pill-allowed clr-pill-disallowed")
                            .addClass(checked ? "clr-pill-allowed" : "clr-pill-disallowed")
                            .text(checked ? "Autorisé" : "Interdit");
                    }
                } else if (mode === "freeze-status") {
                    $card.toggleClass("clr-card-checked", checked);
                    $card.removeClass("clr-card-disallowed");
                    if ($pill.length) {
                        $pill
                            .removeClass("clr-pill-frozen clr-pill-unfrozen")
                            .addClass(checked ? "clr-pill-frozen" : "clr-pill-unfrozen")
                            .text(checked ? "Figé" : "Non figé");
                    }
                } else {
                    $card.toggleClass("clr-card-checked", checked);
                }
            }

            function renderIssueTypesGrid(box, items, selected, $counter) {
                box.empty();
                if (!items.length) {
                    box.append('<div class="clr-empty-msg">Aucun type de ticket trouvé.</div>');
                    updateCounter("clr-it-cb", $counter, "issue-types");
                    return;
                }
                items.forEach(function (item, i) {
                    var value = String(item.id);
                    var id = "clr-it-cb-" + i;
                    var isChecked = (selected.length === 0 || selected.indexOf(value) >= 0);
                    var checkedAttr = isChecked ? ' checked="checked"' : "";
                    var cardClass = "clr-check-card" + (isChecked ? " clr-card-checked" : "");
                    box.append(
                        '<label class="' + cardClass + '" for="' + id + '" data-name="' + escapeHtml(String(item.name).toLowerCase()) + '" title="' + escapeHtml(item.name) + '">' +
                        '<input type="checkbox" class="checkbox clr-it-cb" id="' + id + '" value="' + escapeHtml(value) + '"' + checkedAttr + ' />' +
                        '<span class="clr-card-title">' + escapeHtml(item.name) + '</span>' +
                        '</label>'
                    );
                });
                updateCounter("clr-it-cb", $counter, "issue-types");
            }

            function renderStatusesGrid(box, statuses, cssClass, config, $counter, mode) {
                box.empty();
                if (!statuses.length) {
                    box.append('<div class="clr-empty-msg">Aucun état trouvé pour ce projet.</div>');
                    updateCounter(cssClass, $counter, mode);
                    return;
                }
                var customized = !!config.requestStatusesCustomized;
                var allowedNames = config.allowedRequestStatusNames || [];
                var unblockedNames = config.unblockedStatusNames || [];

                statuses.forEach(function (st, i) {
                    var value = String(st.name);
                    var id = cssClass + "-" + i;
                    var isFinal = !!st.isFinal;
                    var isChecked;

                    if (mode === "allow-request") {
                        if (customized) {
                            isChecked = (allowedNames.indexOf(value) >= 0);
                        } else {
                            // Par défaut : tous les états finaux ne permettent pas de demander d'infos sup
                            isChecked = !isFinal;
                        }
                    } else {
                        // Mode freeze-status : tous les états figent le ticket sauf ceux dans unblockedNames
                        isChecked = (unblockedNames.indexOf(value) < 0);
                    }

                    var checkedAttr = isChecked ? ' checked="checked"' : "";
                    var cardClass = "clr-check-card";
                    if (isChecked) {
                        cardClass += " clr-card-checked";
                    } else if (mode === "allow-request") {
                        cardClass += " clr-card-disallowed";
                    }

                    var finalBadge = isFinal ? '<span class="clr-final-pill" title="État final du workflow">Final</span>' : "";
                    var wfRaw = st.workflows || "";
                    var wfPill = "";
                    var tooltip = st.name + (isFinal ? " (État final)" : "");
                    if (wfRaw) {
                        var wfList = wfRaw.split(", ");
                        var pillText = wfList.length > 1 ? (wfList.length + " wf") : wfList[0];
                        tooltip += " — Workflow(s) : " + wfRaw;
                        wfPill = '<span class="clr-wf-pill" title="' + escapeHtml("Workflow(s) : " + wfRaw) + '">' + escapeHtml(pillText) + '</span>';
                    }

                    var statePill = "";
                    if (mode === "allow-request") {
                        statePill = '<span class="clr-state-pill ' + (isChecked ? 'clr-pill-allowed' : 'clr-pill-disallowed') + '">' + (isChecked ? 'Autorisé' : 'Interdit') + '</span>';
                    } else {
                        statePill = '<span class="clr-state-pill ' + (isChecked ? 'clr-pill-frozen' : 'clr-pill-unfrozen') + '">' + (isChecked ? 'Figé' : 'Non figé') + '</span>';
                    }

                    box.append(
                        '<label class="' + cardClass + '" for="' + id + '" data-name="' + escapeHtml(value.toLowerCase()) + '" data-wfs="' + escapeHtml(wfRaw.toLowerCase()) + '" data-final="' + (isFinal ? '1' : '0') + '" title="' + escapeHtml(tooltip) + '">' +
                        '<input type="checkbox" class="checkbox ' + cssClass + '" id="' + id + '" value="' + escapeHtml(value) + '"' + checkedAttr + ' />' +
                        '<span class="clr-card-title">' + escapeHtml(value) + '</span>' +
                        finalBadge +
                        wfPill +
                        statePill +
                        '</label>'
                    );
                });
                updateCounter(cssClass, $counter, mode);
            }

            function populateWorkflowFilters(statuses) {
                var $wfSelects = $("#clr-req-st-wf-filter, #clr-blk-st-wf-filter");
                var wfSet = {};
                var wfOrder = [];
                (statuses || []).forEach(function (st) {
                    if (st.workflows) {
                        st.workflows.split(", ").forEach(function (w) {
                            var clean = $.trim(w);
                            if (clean && !wfSet[clean]) {
                                wfSet[clean] = true;
                                wfOrder.push(clean);
                            }
                        });
                    }
                });
                if (wfOrder.length > 1) {
                    $wfSelects.each(function () {
                        var $sel = $(this).empty().append('<option value="">Tous les workflows (' + wfOrder.length + ')</option>');
                        wfOrder.forEach(function (w) {
                            $sel.append('<option value="' + escapeHtml(w.toLowerCase()) + '">' + escapeHtml(w) + '</option>');
                        });
                        $sel.show();
                    });
                } else {
                    $wfSelects.hide();
                }
            }

            function filterCards($box, query, wfFilter) {
                var q = $.trim(query || "").toLowerCase();
                var wf = $.trim(wfFilter || "").toLowerCase();
                $box.find(".clr-check-card").each(function () {
                    var $card = $(this);
                    var name = String($card.attr("data-name") || "");
                    var wfs = String($card.attr("data-wfs") || "");
                    var matchName = !q || name.indexOf(q) >= 0;
                    var matchWf = !wf || wfs.split(", ").indexOf(wf) >= 0;
                    $card.toggle(matchName && matchWf);
                });
            }

            function collectCheckedOrEmptyIfAll(cssClass) {
                var values = [], all = true;
                $("." + cssClass).each(function () {
                    if (this.checked) { values.push(this.value); } else { all = false; }
                });
                return all ? [] : values;
            }

            function collectChecked(cssClass) {
                var checked = [];
                $("." + cssClass).each(function () {
                    if (this.checked) { checked.push(this.value); }
                });
                return checked;
            }

            function collectUnchecked(cssClass) {
                var unchecked = [];
                $("." + cssClass).each(function () {
                    if (!this.checked) { unchecked.push(this.value); }
                });
                return unchecked;
            }

            $.ajax({ url: restUrl, type: "GET", dataType: "json", cache: false })
                .done(function (data) {
                    var config = data.config || {};
                    $("#clr-enabled").prop("checked", config.enabled !== false);
                    $("#clr-pause-sla").prop("checked", config.pauseSla !== false);

                    if (data.slaFieldName) {
                        $("#clr-sla-field-name").text(data.slaFieldName);
                    }
                    if (data.slaFieldId) {
                        $("#clr-sla-field-info").text("Champ prêt : " + data.slaFieldId).show();
                    } else {
                        $("#clr-sla-field-info").hide();
                    }

                    var issueTypes = data.issueTypes || [];
                    var statuses = data.statuses || [];

                    populateWorkflowFilters(statuses);
                    renderIssueTypesGrid($("#clr-issue-types-list"), issueTypes, config.enabledIssueTypeIds || [], $("#clr-it-counter"));
                    renderStatusesGrid($("#clr-req-statuses-list"), statuses, "clr-req-st-cb", config, $("#clr-req-st-counter"), "allow-request");
                    renderStatusesGrid($("#clr-blk-statuses-list"), statuses, "clr-blk-st-cb", config, $("#clr-blk-st-counter"), "freeze-status");

                    $("#clr-config-loading").hide();
                    $("#clr-config-form").show();
                })
                .fail(function (xhr) {
                    $("#clr-config-loading").hide();
                    $("#clr-config-error-msg").text(xhr.status === 403
                        ? "Accès réservé aux administrateurs du projet."
                        : "Impossible de charger la configuration (erreur " + xhr.status + ").");
                    $("#clr-config-error").show();
                });

            $(document)
                .on("change", ".clr-it-cb", function () {
                    syncCardAppearance($(this), "issue-types");
                    updateCounter("clr-it-cb", $("#clr-it-counter"), "issue-types");
                })
                .on("change", ".clr-req-st-cb", function () {
                    syncCardAppearance($(this), "allow-request");
                    updateCounter("clr-req-st-cb", $("#clr-req-st-counter"), "allow-request");
                })
                .on("change", ".clr-blk-st-cb", function () {
                    syncCardAppearance($(this), "freeze-status");
                    updateCounter("clr-blk-st-cb", $("#clr-blk-st-counter"), "freeze-status");
                })
                .on("input", "#clr-it-search", function () {
                    filterCards($("#clr-issue-types-list"), $(this).val(), "");
                })
                .on("input", "#clr-req-st-search", function () {
                    filterCards($("#clr-req-statuses-list"), $(this).val(), $("#clr-req-st-wf-filter").val());
                })
                .on("change", "#clr-req-st-wf-filter", function () {
                    filterCards($("#clr-req-statuses-list"), $("#clr-req-st-search").val(), $(this).val());
                })
                .on("input", "#clr-blk-st-search", function () {
                    filterCards($("#clr-blk-statuses-list"), $(this).val(), $("#clr-blk-st-wf-filter").val());
                })
                .on("change", "#clr-blk-st-wf-filter", function () {
                    filterCards($("#clr-blk-statuses-list"), $("#clr-blk-st-search").val(), $(this).val());
                })
                .on("click", "#clr-req-st-default", function () {
                    $(".clr-req-st-cb").each(function () {
                        var $card = $(this).closest(".clr-check-card");
                        var isFinal = $card.attr("data-final") === "1";
                        this.checked = !isFinal;
                        syncCardAppearance($(this), "allow-request");
                    });
                    updateCounter("clr-req-st-cb", $("#clr-req-st-counter"), "allow-request");
                })
                .on("click", ".clr-select-all, .clr-select-none", function () {
                    var check = $(this).hasClass("clr-select-all");
                    var targetClass = $(this).data("target");
                    var mode = targetClass === "clr-req-st-cb" ? "allow-request" : (targetClass === "clr-blk-st-cb" ? "freeze-status" : "issue-types");
                    var $counter = targetClass === "clr-req-st-cb" ? $("#clr-req-st-counter") : (targetClass === "clr-blk-st-cb" ? $("#clr-blk-st-counter") : $("#clr-it-counter"));
                    $("." + targetClass).each(function () {
                        var $card = $(this).closest(".clr-check-card");
                        if ($card.is(":visible")) {
                            this.checked = check;
                            syncCardAppearance($(this), mode);
                        }
                    });
                    updateCounter(targetClass, $counter, mode);
                });

            $("#clr-config-form").on("submit", function (e) {
                e.preventDefault();
                var saveBtn = $("#clr-save-btn").prop("disabled", true).text("Enregistrement...");
                $("#clr-save-status").text("");

                var payload = {
                    enabled: $("#clr-enabled").prop("checked"),
                    pauseSla: $("#clr-pause-sla").prop("checked"),
                    enabledIssueTypeIds: collectCheckedOrEmptyIfAll("clr-it-cb"),
                    requestStatusesCustomized: true,
                    allowedRequestStatusNames: collectChecked("clr-req-st-cb"),
                    unblockedStatusNames: collectUnchecked("clr-blk-st-cb")
                };

                $.ajax({
                    url: restUrl,
                    type: "POST",
                    contentType: "application/json; charset=UTF-8",
                    data: JSON.stringify(payload),
                    headers: { "X-Atlassian-Token": "no-check" }
                })
                .done(function () {
                    $("#clr-save-status").css("color", "#00875a").text("Configuration enregistrée.");
                    if (typeof AJS.flag === "function") {
                        AJS.flag({ type: "success", body: "Configuration enregistrée.", close: "auto" });
                    }
                })
                .fail(function (xhr) {
                    $("#clr-save-status").css("color", "#de350b").text("Erreur lors de l'enregistrement (" + xhr.status + ").");
                })
                .always(function () {
                    saveBtn.prop("disabled", false).text("Enregistrer");
                });
            });
        }

        if (window.AJS && AJS.toInit) { AJS.toInit(start); }
        else { document.addEventListener("DOMContentLoaded", start); }
    })();
    </script>
</body>
</html>
