<atlassian-plugin key="${atlassian.plugin.key}" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}" />
        <param name="atlassian-data-center-status">compatible</param>
        <param name="atlassian-data-center-compatible">true</param>
    </plugin-info>

    <!-- Fichier de messages internationalisés (i18n) -->
    <resource type="i18n" name="i18n" location="i18n/jira-clarification-loop"/>

    <!-- Ressources Web (JS, CSS, AUI Dialog2) chargées sur la vue des tickets -->
    <web-resource key="clarification-resources-v14" name="Ressources Web Demande infos sup">
        <dependency>com.atlassian.auiplugin:ajs</dependency>
        <dependency>com.atlassian.auiplugin:aui-flag</dependency>
        <dependency>com.atlassian.auiplugin:dialog2</dependency>

        <resource type="download" name="clarification.css" location="/css/clarification.css"/>
        <resource type="download" name="clarification.js" location="/js/clarification.js"/>

        <context>jira.view.issue</context>
    </web-resource>

    <!-- Panneau latéral transverse placé en 2e position (weight=20, entre Personnes=10 et Dates=40).
         Masqué si le module est désactivé pour le projet / type de ticket (actif par défaut). -->
    <web-panel key="demande-infos-sup" name="Demande infos sup" location="atl.jira.view.issue.right.context" weight="20">
        <description>Permet de demander des informations supplémentaires et d'enregistrer les allers-retours de validation</description>
        <label key="demande.infos.sup.label">Demande infos sup</label>
        <resource name="view" type="velocity" location="templates/clarification-panel.vm"/>
        <condition class="com.socgen.jira.plugins.clarification.condition.ClarificationPanelCondition"/>
    </web-panel>

    <!-- API REST transverse : /rest/clarification/1.0/issue/{issueKey} -->
    <rest key="clarification-rest" path="/clarification" version="1.0">
        <description>API REST pour les demandes d'informations supplémentaires et réponses</description>
        <package>com.socgen.jira.plugins.clarification.rest</package>
    </rest>

    <!-- API JSON de configuration par projet : /plugins/servlet/clarification-config?projectKey=XXX -->
    <servlet key="clarification-config-servlet" name="Demande infos sup - API configuration"
             class="com.socgen.jira.plugins.clarification.servlet.ClarificationConfigServlet">
        <description>API JSON pour lire/écrire la configuration du module par projet</description>
        <url-pattern>/clarification-config</url-pattern>
    </servlet>

    <!-- Page de configuration par projet : /plugins/servlet/clarification-config-page?projectKey=XXX -->
    <servlet key="clarification-config-page-servlet" name="Demande infos sup - Page configuration"
             class="com.socgen.jira.plugins.clarification.servlet.ClarificationConfigPageServlet">
        <description>Page de configuration du module Demande infos sup dans les paramètres du projet</description>
        <url-pattern>/clarification-config-page</url-pattern>
    </servlet>

    <!-- Lien dans la barre latérale « Paramètres du projet » (droits admin projet vérifiés côté servlet) -->
    <web-item key="clarification-project-config-link" name="Demande infos sup - Lien paramètres projet"
              section="atl.jira.proj.config/projectgroup4" weight="200">
        <label key="clarification.project.config.label">Demande infos sup</label>
        <link linkId="clarification-project-config-link">/plugins/servlet/clarification-config-page?projectKey=$projectKeyEncoded</link>
    </web-item>

    <!-- Fonction JQL : issue in pendingInfoSup() -->
    <jql-function key="pending-info-sup-function" name="pendingInfoSup"
                  class="com.socgen.jira.plugins.clarification.jql.PendingInfoSupFunction">
        <description>Retourne les tickets ayant une demande d'informations supplémentaires en attente.</description>
        <fname>pendingInfoSup</fname>
        <list>true</list>
    </jql-function>

</atlassian-plugin>
