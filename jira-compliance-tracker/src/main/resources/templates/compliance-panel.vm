<div id="compliance-panel-root" class="module toggle-wrap" data-issue-key="$issue.key">
    <div class="mod-header">
        <ul class="ops"></ul>
        <h4 class="toggle-title">
            <span class="aui-icon aui-icon-small aui-iconfont-locked" style="margin-right: 4px;"></span>
            Visa &amp; Conformité DPI
        </h4>
    </div>
    <div class="mod-content" style="padding: 12px;">
        <div id="compliance-status-area">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                <span style="font-weight: 600; font-size: 12px; color: #172B4D;">Statut d'audit :</span>
                <span id="compliance-badge" class="aui-lozenge aui-lozenge-subtle">Chargement...</span>
            </div>
            
            <div id="compliance-details" style="display: none; font-size: 12px; color: #505F79; background: #F4F5F7; padding: 8px; border-radius: 3px; margin-bottom: 8px;">
                <div style="margin-bottom: 4px;">
                    <strong>Auditeur :</strong> <span id="compliance-reviewer">-</span>
                </div>
                <div style="margin-bottom: 4px;">
                    <strong>Date :</strong> <span id="compliance-date">-</span>
                </div>
                <div>
                    <strong>Commentaire :</strong> <span id="compliance-comment" style="font-style: italic;">-</span>
                </div>
            </div>
        </div>

        <div class="compliance-actions" style="margin-top: 8px; border-top: 1px solid #DFE1E6; padding-top: 8px; display: flex; gap: 6px;">
            <button id="btn-validate-compliance" class="aui-button aui-button-primary aui-button-compact" type="button" title="Accorder le visa de conformité DPI">
                <span class="aui-icon aui-icon-small aui-iconfont-approve"></span> Valider
            </button>
            <button id="btn-reject-compliance" class="aui-button aui-button-compact" type="button" title="Refuser ou révoquer le visa" style="color: #DE350B;">
                Refuser
            </button>
        </div>
    </div>
</div>
